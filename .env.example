# Credenciais do PostgreSQL local (lidas pelo docker-compose.yml).
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal_tg
POSTGRES_PORT=5434

# Connection string usada pela aplicacao e pelo drizzle-kit.
# Deve refletir as variaveis acima quando o banco roda via Docker Compose.
DATABASE_URL=postgresql://portal:portal@localhost:5434/portal_tg

# Z-API (WhatsApp) — usada pelas mensagens de tratativa do modulo de ponto.
# Opcionais: sem elas o portal funciona normalmente e a tela da ocorrencia
# informa que o envio esta indisponivel. As tres vem do painel da Z-API,
# em Instancias -> a sua instancia (as duas primeiras) e em Seguranca
# (o Client-Token da conta).
ZAPI_BASE_URL=https://api.z-api.io
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Segredo do webhook do chatbot de ponto. Configure na Z-API, em "Ao receber":
#   https://<dominio-do-portal>/api/whatsapp/webhook?token=<este valor>
# ou, com o segredo no caminho:
#   https://<dominio-do-portal>/api/whatsapp/webhook/<este valor>
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Vazio = webhook desligado.
ZAPI_WEBHOOK_SECRET=

# O robo que conversa com o colaborador. false desliga so a conversa: o webhook
# continua respondendo 200 (senao a Z-API reentrega para sempre), mas nada e
# gravado e ninguem recebe resposta.
ZAPI_CHATBOT_ATIVO=true
